# 이 파일을 복사해서 이름을 ".env"로 바꾸고(같은 폴더), = 뒤에 값을 넣으세요.
# .env는 내 PC에만 둡니다. 키를 채팅, 월드, GitHub 등 남이 볼 수 있는 곳에 올리지 마세요.
# Copy this file to ".env" (same folder) and fill in the values. Never share or commit .env.

# 필수: Claude API 키 (https://console.anthropic.com 에서 만듦)
ANTHROPIC_API_KEY=

# 선택: 마이크 번호 (run.cmd --list 로 확인). 비우면 Windows 기본 마이크
MIC_DEVICE=

# 선택: Whisper 모델 이름과 저장 폴더. 비우면 turbo, %USERPROFILE%\.cache\whisper
WHISPER_MODEL=
WHISPER_MODEL_DIR=

# 선택: Whisper 탐색 폭. 비우거나 1이면 기존 빠른 방식, 5이면 후보를 비교하는 방식(더 느릴 수 있음).
W04_WHISPER_BEAM_SIZE=

# 선택: 성격 파일. 비우면 persona.md
PERSONA_FILE=

# 선택: 웹 검색. 비우거나 1이면 켬(날씨·뉴스 같은 질문에만 검색, 검색 1번에 약 $0.01), 0이면 끔
W04_WEB_SEARCH=

# 기본 허용 월드의 ID (wrld_...). 앱은 이 목록에 .env 또는 환경변수의 목록을 더합니다.
# 유니티의 Build & Test(로컬 시험) 월드는 적지 않아도 항상 허용됩니다.
# 여기에 없는 업로드된 월드에서는 말 걸기(바라보고 말하기, 점프로 말하기)와 월드 안 설정 창이 동작하지 않습니다.
# 예: W04_WORLD_IDS=wrld_11111111-2222-3333-4444-555555555555
W04_WORLD_IDS=wrld_304f55b9-d4ac-45b2-8ab6-73ecba7f71fe,wrld_623e84cc-7561-4d9e-8ad4-6e4365cf9bff,wrld_60a46676-76cd-4c5f-bb89-e9113b001f17,wrld_48f8f70f-041e-4a44-a448-f6afcda80850

# 선택: 말 거는 방법. 비우면 gaze
#   gaze = NPC를 가까이서 바라보는 동안 마이크를 듣고, 말하면 알아듣습니다(점프 누르고 말하기도 됨)
#   ptt  = 점프(Space / 오른손 A)를 누르고 있는 동안만 듣습니다
W04_LISTEN_MODE=
